%% ColdSense GCP Architecture - Mermaid Diagram
%% This can be rendered at: https://mermaid.live or in VS Code with Mermaid extension

graph TB
    subgraph Internet["🌐 INTERNET"]
        Users["👥 Users<br/>(Owners, Farmers, Stakeholders)"]
    end

    subgraph GCP["☁️ GOOGLE CLOUD PLATFORM<br/>Project: exalted-skein-505210-g0<br/>Region: asia-south1 (Mumbai)"]
        
        subgraph Firewall["🔥 Firewall Rules"]
            FW1["allow-http (80)"]
            FW2["allow-backend (8000)"]
            FW3["allow-mqtt (1883)"]
        end
        
        subgraph VM["💻 Compute Engine VM<br/>coldsense-backend-vm<br/>e2-medium (2vCPU, 4GB)<br/>IP: 8.231.107.201"]
            
            subgraph Docker["🐳 Docker Containers"]
                Backend["FastAPI Backend<br/>Port: 8000<br/>- REST API<br/>- Auth Handler<br/>- Business Logic"]
                
                MQTT["Mosquitto MQTT<br/>Port: 1883<br/>- IoT Broker<br/>- Message Routing"]
                
                Simulator["Sensor Simulator<br/>- Generate Test Data<br/>- Publish to MQTT"]
            end
        end
        
        subgraph Registry["📦 Artifact Registry"]
            BackendImg["backend:latest"]
            SimulatorImg["simulator:latest"]
        end
    end
    
    subgraph External["🌍 EXTERNAL SERVICES"]
        Supabase["🗄️ Supabase<br/>(PostgreSQL)<br/>- Authentication<br/>- Database<br/>- Real-time<br/>- RLS"]
        
        Frontend["⚛️ Frontend<br/>(React + Vite)<br/>- User Interface<br/>- Dashboards<br/>- Charts"]
    end
    
    subgraph IoT["📡 IoT SENSORS (Future)"]
        Sensors["Temperature<br/>Humidity<br/>Door<br/>Energy"]
    end

    %% Connections
    Users -->|HTTPS| Frontend
    Frontend -->|REST API<br/>Bearer Token| Backend
    Backend -->|PostgreSQL<br/>over SSL| Supabase
    
    Sensors -.->|MQTT| MQTT
    Simulator -->|MQTT Publish| MQTT
    MQTT -->|Subscribe| Backend
    
    Backend -.->|Pull Images| Registry
    
    Firewall -->|Allow Traffic| VM
    
    %% Styling
    classDef gcpStyle fill:#4285f4,stroke:#1a73e8,stroke-width:2px,color:#fff
    classDef externalStyle fill:#34a853,stroke:#0f9d58,stroke-width:2px,color:#fff
    classDef containerStyle fill:#fbbc04,stroke:#f57c00,stroke-width:2px,color:#000
    classDef iotStyle fill:#ea4335,stroke:#c5221f,stroke-width:2px,color:#fff
    
    class GCP,VM,Registry,Firewall gcpStyle
    class Supabase,Frontend externalStyle
    class Backend,MQTT,Simulator containerStyle
    class IoT,Sensors iotStyle
